# Copy to .env and fill in. Real environment variables take precedence.

# Anthropic API key (recommended). If unset, the app falls back to a locally
# installed and logged-in `claude` CLI (Claude Code) as the model provider.
ANTHROPIC_API_KEY=

# Optional overrides
# CASE_BUDDY_PROVIDER=anthropic        # anthropic | claude-cli | mock
# CASE_BUDDY_MODEL=claude-opus-5
# CASE_BUDDY_EFFORT_INTERVIEWER=low    # low | medium | high | xhigh | max
# CASE_BUDDY_EFFORT_ANALYZER=medium
# CASE_BUDDY_EFFORT_COACH=high
# CASE_BUDDY_FALLBACKS=on              # server-side refusal fallbacks (Anthropic API)
# PORT=3000
